# ---------------------------------------------------------------------------
# Swaraavali — environment variables
# Copy to .env.local and fill in. Phase 1 (base site) needs NONE of these;
# they are consumed starting in Phase 2 (backend).
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase Postgres) — Phase 2 ---
DATABASE_URL=

# --- Supabase Auth (admin) — Phase 2 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend transactional email — Phase 2 ---
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=Simfacktd@gmail.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Upstash rate limiting — Phase 2 ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile (optional spam protection) — Phase 2 ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
